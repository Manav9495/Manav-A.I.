# =========================================================================
# Manav A.I. — Git Ignore Rules
# =========================================================================

# Dependencies
node_modules/
**/node_modules/
package-lock.json
**/package-lock.json

# Environment variables & secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System files
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~

# IDEs & Code Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Temporary & cache files
.cache/
.temp/
tmp/
